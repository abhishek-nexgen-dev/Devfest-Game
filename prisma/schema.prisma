// GDG Ranchi DevFest 2026 - Participant & Game Management Schema
// Generated for PostgreSQL (Google Cloud SQL / Local PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
 
}

enum Role {
  SUPER_ADMIN
  PARTICIPANT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum GameType {
  INDIVIDUAL
  TEAM
}

enum GameStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  role      Role       @default(PARTICIPANT)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  participant  Participant?
  activityLogs ActivityLog[]

  @@map("users")
}

model Participant {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  participantId String   @unique @map("participant_id")
  name          String
  mobile        String
  organization  String?
  city          String?
  profilePhoto  String?  @map("profile_photo")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMembers   TeamMember[]
  registrations GameRegistration[]
  submissions   GameSubmission[]
  results       GameResult[]
  scoreLogs     ScoreUpdateLog[]
  certificates  Certificate[]

  @@index([participantId])
  @@map("participants")
}

model Team {
  id        String   @id @default(uuid())
  teamName  String   @unique @map("team_name")
  teamCode  String   @unique @map("team_code")
  leaderId  String   @map("leader_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members       TeamMember[]
  registrations GameRegistration[]
  submissions   GameSubmission[]
  results       GameResult[]
  scoreLogs     ScoreUpdateLog[]

  @@index([teamCode])
  @@map("teams")
}

model TeamMember {
  id            String   @id @default(uuid())
  teamId        String   @map("team_id")
  participantId String   @map("participant_id")
  joinedAt      DateTime @default(now()) @map("joined_at")

  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([teamId, participantId])
  @@map("team_members")
}

model Game {
  id          String     @id @default(uuid())
  title       String
  description String?
  gameType    GameType   @default(INDIVIDUAL) @map("game_type")
  status      GameStatus @default(UPCOMING)
  maxScore    Int        @default(100) @map("max_score")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  registrations GameRegistration[]
  submissions   GameSubmission[]
  results       GameResult[]
  scoreLogs     ScoreUpdateLog[]

  @@map("games")
}

model GameRegistration {
  id            String   @id @default(uuid())
  gameId        String   @map("game_id")
  participantId String?  @map("participant_id")
  teamId        String?  @map("team_id")
  registeredAt  DateTime @default(now()) @map("registered_at")

  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([gameId, participantId])
  @@unique([gameId, teamId])
  @@map("game_registrations")
}

model GameSubmission {
  id             String   @id @default(uuid())
  gameId         String   @map("game_id")
  participantId  String?  @map("participant_id")
  teamId         String?  @map("team_id")
  submissionData String?  @map("submission_data")
  submittedAt    DateTime @default(now()) @map("submitted_at")

  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("game_submissions")
}

model GameResult {
  id            String   @id @default(uuid())
  gameId        String   @map("game_id")
  participantId String?  @map("participant_id")
  teamId        String?  @map("team_id")
  score         Int      @default(0)
  verified      Boolean  @default(false)
  verifiedBy    String?  @map("verified_by")
  updatedAt     DateTime @updatedAt @map("updated_at")

  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([gameId, participantId])
  @@unique([gameId, teamId])
  @@map("game_results")
}

model ScoreUpdateLog {
  id            String   @id @default(uuid())
  gameId        String   @map("game_id")
  participantId String?  @map("participant_id")
  teamId        String?  @map("team_id")
  oldScore      Int      @map("old_score")
  newScore      Int      @map("new_score")
  updatedBy     String   @map("updated_by")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("score_update_logs")
}

model Certificate {
  id               String   @id @default(uuid())
  certificateNo    String   @unique @map("certificate_no")
  participantId    String   @map("participant_id")
  participantName  String   @map("participant_name")
  verificationHash String   @unique @map("verification_hash")
  certificateUrl   String?  @map("certificate_url")
  issuedAt         DateTime @default(now()) @map("issued_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([verificationHash])
  @@map("certificates")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  details   String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}
