# ==========================================
# GDG Ranchi DevFest 2026 - Backend Config
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Google Cloud SQL / PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devfest_game_db?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/devfest_game_db?schema=public

# JWT Authentication
JWT_SECRET=devfest_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Initial Super Admin Seed Credentials
INITIAL_ADMIN_EMAIL=admin@gdgranchi.in
INITIAL_ADMIN_PASSWORD=AdminPass@2026
INITIAL_ADMIN_NAME="GDG Ranchi Super Admin"

# Firebase Storage (Google Cloud / Firebase Storage)
FIREBASE_PROJECT_ID=gdg-ranchi-devfest-2026
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@gdg-ranchi-devfest-2026.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=gdg-ranchi-devfest-2026.appspot.com

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=devfest@gdgranchi.in
SMTP_PASS=your_email_app_password
EMAIL_FROM="GDG Ranchi DevFest <devfest@gdgranchi.in>"
