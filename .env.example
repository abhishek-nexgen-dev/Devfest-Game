# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL Database Configuration (pg)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_USER=postgres
DB_HOST=localhost
DB_NAME=devfest_game_db
DB_PASSWORD=your_database_password_here
DB_PORT=5432
DB_SSL=false

# JWT Authentication (REQUIRED)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# Initial Super Admin Seed Credentials (REQUIRED)
INITIAL_ADMIN_EMAIL=admin@gdgranchi.in
INITIAL_ADMIN_PASSWORD=your_strong_admin_password_here
INITIAL_ADMIN_NAME=GDG Ranchi Super Admin
